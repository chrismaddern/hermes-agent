    "conversation.bind",
    "turn.submit",
    "turn.cancel",
    "event.ack"
  ],
  "contract_version": "agent_stack.channel.v1",
  "dispatch": {
    "available": true,
    "degraded_reason": null
  },
  "document_type": "capabilities",
